# Owera Channels Manager — copy to .env (never commit real secrets)

# HTTP Basic Auth for the portal (empty = local-only, no auth).
# When MANAGER_MULTI_WORKSPACE=1, the Basic Auth *username* must be the workspace slug
# (e.g. owera), not empty — use curl -u "owera:$MANAGER_APP_PASSWORD".
MANAGER_APP_PASSWORD=

# Public URL base for legacy per-channel OAuth redirects (optional)
MANAGER_PUBLIC_BASE_URL=

# Platform Google Web OAuth — keep 0 until operator enables on claw0
MANAGER_GOOGLE_WEB_OAUTH=0
MANAGER_GOOGLE_CLIENT_ID=
MANAGER_GOOGLE_CLIENT_SECRET=
MANAGER_OAUTH_REDIRECT_URI=https://channels.owera.com/api/oauth/google/callback
# Platform OAuth token encryption (env key is MANAGER_TOKEN_ENC_KEY, not TOKEN_ENC_KEY)
MANAGER_TOKEN_ENC_KEY=

# SPA human login (Google Sign-In → session cookie). Separate GCP Web OAuth client
# from YouTube Connect (MANAGER_GOOGLE_*). Project 618513602444.
# Allowlist (v1): rodrigo@owera.com → workspace owera (code-locked in app).
MANAGER_SPA_GOOGLE_LOGIN=0
MANAGER_SPA_GOOGLE_CLIENT_ID=
MANAGER_SPA_GOOGLE_CLIENT_SECRET=
MANAGER_SPA_GOOGLE_REDIRECT_URI=https://channels.owera.com/api/auth/google/callback
# Local dev redirect: http://127.0.0.1:7070/api/auth/google/callback
# Authorized JS origins (GCP console): https://channels.owera.com , http://127.0.0.1:7070
MANAGER_SESSION_SECRET=
# S5 test workspaces: dedicated Google accounts (comma-separated, case-insensitive)
# allowed to own / sign in to an is_test workspace (provision_test_workspace).
# Never an owera allowlist email. Default empty.
MANAGER_TEST_WORKSPACE_EMAILS=
# Set 1 behind HTTPS so the session cookie and logout deletion both use Secure.
MANAGER_SESSION_COOKIE_SECURE=0

# Multi-tenant workspace isolation — keep 0 for EA until CF Access + slug binding
MANAGER_MULTI_WORKSPACE=0
MANAGER_ALLOW_WORKSPACE_HEADER=0

# Safety ceiling (units/day); workspace row may set a lower cap
MANAGER_YOUTUBE_DAILY_QUOTA_CAP=9000

# Light LLM completions (ideas / autofill / trends / metadata).
# Default low; empty = CLI default (currently high). Compose stays on MANAGER_GROK_COMPOSE_REASONING_EFFORT.
# MANAGER_GROK_EFFORT_IDEAS=low

# LLM hard guard (docs/LLM_GUARD.md). Only these workspace ids may reach the LLM.
# Default 1 = owera. Empty / malformed = nothing allowed.
# MANAGER_LLM_INTERNAL_WORKSPACE_IDS=1

# Headless agents (growth, code, run-check) only observe/act on these workspaces.
# Default 1. Ids not also in MANAGER_LLM_INTERNAL_WORKSPACE_IDS are dropped (logged)
# and never enter the agent context; an empty effective set refuses the run.
# MANAGER_AGENT_RUN_WORKSPACE_IDS=1

# S7 day-6 token-renewal check (token_refresh_age job): channels in these workspaces
# are logged info-only (no stale marker). Separate from the LLM allowlist on purpose:
# approved buyers join that list and must still be watched here. Default 1 = owera.
# Empty / malformed = every workspace is treated as external.
# MANAGER_TOKEN_AGE_INTERNAL_WORKSPACE_IDS=1

# S8 external LLM release (docs/LLM_GUARD.md). 0 (default) = the
# MANAGER_LLM_INTERNAL_WORKSPACE_IDS allowlist is the whole rule. 1 lets a
# non-internal workspace reach the LLM only if paid or is_test, terms + privacy
# accepted, not kill-switched, LLM_BACKEND=api with XAI_DATA_RETENTION_ACK, for a
# released purpose. Turning it on is a CTO/LegalOps/CoS/PO decision.
MANAGER_LLM_EXTERNAL_RELEASE=0

# Per-workspace monthly LLM subcap (USD, UTC month) for external (non-allowlisted)
# workspaces; internal allowlisted workspaces are exempt. Counted from the usage
# ledger. Default 5. The global MANAGER_LLM_MONTHLY_USD_CAP still applies.
# MANAGER_LLM_WORKSPACE_MONTHLY_USD_CAP=5
# #214 media purge of unpublished drafts: log the plan only, delete nothing (default false).
# MANAGER_PURGE_MEDIA_DRY_RUN=false
# S2 Terms + Privacy checkbox: the only accepted / stored sentence shas (sha256 of the exact
# sentence shown). Defaults = the current LegalOps FIX4 EN / PT sentences.
# MANAGER_TERMS_VERSION_SHA_EN=91a6c69ec169f1877ba16cbc00508880116bebf9965c01cdf0646ca3bbf1fea3
# MANAGER_TERMS_VERSION_SHA_PT=16d920da6551837b890154f05de232fd48d7cfee409496184d2d294de7a81a19
# PT terms gate: true only once owera.com/terms/pt/ is live (default false = EN for everyone;
# a PT acceptance is not treated as consent).
# MANAGER_TERMS_PT_LIVE=false
