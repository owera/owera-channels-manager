{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://owera.com/schemas/content-brief.schema.json",
  "title": "ContentBrief",
  "description": "DESIGN-ONLY CMO brief v2 contract. Not imported by the app. Implementation needs a separate Rodrigo yes. Hub networks are youtube_os, instagram, linkedin, x only. Per-network format matrix is locked: youtube_os kind=short 9:16, instagram kind=reel 9:16, linkedin kind=video 1:1 (alt 4:5), x kind=video 16:9. linkedin/x kind enum is video — NEVER image or still. Stills are review placeholders only, not the publication kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "target_networks",
    "angle",
    "voz",
    "hard_nos",
    "art",
    "cta",
    "status",
    "publications"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Optional review id. Not a Video.id."
    },
    "objective": {
      "type": "string",
      "enum": ["ypp_click_watch_sub", "news_angle_social"]
    },
    "target_networks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/network" }
    },
    "angle": {
      "type": "string",
      "minLength": 1,
      "description": "Pillar / angle."
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Required when objective is news_angle_social."
    },
    "voz": { "$ref": "#/definitions/voz" },
    "hard_nos": { "$ref": "#/definitions/hardNos" },
    "art": { "$ref": "#/definitions/art" },
    "cta": { "$ref": "#/definitions/cta" },
    "status": { "$ref": "#/definitions/briefStatus" },
    "publications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/publication" },
      "description": "Exactly one adapter per target_networks entry. Native format lives here, not on a second art root."
    }
  },
  "if": {
    "properties": { "objective": { "const": "news_angle_social" } },
    "required": ["objective"]
  },
  "then": { "required": ["source_url"] },
  "definitions": {
    "network": {
      "type": "string",
      "enum": ["youtube_os", "instagram", "linkedin", "x"]
    },
    "briefStatus": {
      "type": "string",
      "enum": ["draft", "cmo", "cos", "rodrigo_yes", "publish"],
      "description": "Manual only. draft → cmo → cos → rodrigo_yes → publish. No auto-publish."
    },
    "voz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "register", "first_line_is_spoken", "cadence"],
      "properties": {
        "language": {
          "const": "en",
          "description": "Company English. Locked."
        },
        "register": {
          "const": "spoken_builder",
          "description": "EN spoken/builder. Not corporate teaser."
        },
        "first_line_is_spoken": {
          "const": true,
          "description": "1ª linha falada. First line IS the spoken line."
        },
        "cadence": {
          "const": "rodrigo_simple",
          "description": "Company inherits the tone of Rodrigo personal spoken anchors, not the content. Do not paste Grok/Chrome/TCE into company briefs."
        }
      }
    },
    "hardNos": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "allOf": [
        { "contains": { "const": "Aquila" } },
        { "contains": { "const": "TCE" } },
        { "contains": { "const": "Agenda internals" } },
        { "contains": { "const": "Cloud-as-if-ready" } },
        { "contains": { "const": "walkthrough" } },
        { "contains": { "const": "IP/VPN" } },
        { "contains": { "const": "client names" } },
        { "contains": { "const": "invented metrics" } },
        { "contains": { "const": "spend" } }
      ],
      "description": "Locked set always in force. Extra strings allowed. Removals invalid."
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "description": "ONE object on the brief root. Adaptations are publications[].format, not a second art root.",
      "required": [
        "must_illustrate_copy",
        "generic_o_lockup",
        "teaser_not_walkthrough",
        "teaser_not_final_ui",
        "channels_manager_coming_soon",
        "os_rr_split_every_aspect",
        "decolar_object_every_aspect",
        "widget_text_color"
      ],
      "properties": {
        "must_illustrate_copy": { "const": true },
        "generic_o_lockup": {
          "const": false,
          "description": "Generic O lockup is forbidden."
        },
        "teaser_not_walkthrough": {
          "const": true,
          "description": "Teaser of the coming-soon product. NEVER a walkthrough or Cloud-as-if-ready."
        },
        "teaser_not_final_ui": {
          "const": true,
          "description": "Never a final UI / walkthrough-as-if-ready frame."
        },
        "channels_manager_coming_soon": {
          "const": true,
          "description": "Channels Manager is still in development. Feature videos are teasers for a future launch, not a product walkthrough."
        },
        "os_rr_split_every_aspect": {
          "const": true,
          "description": "OS/RR split tokens apply in every publication aspect, including stills/frames cropped from the teaser."
        },
        "decolar_object_every_aspect": {
          "const": true,
          "description": "Decolar object applies in every publication aspect."
        },
        "widget_text_color": {
          "const": "#fff",
          "description": "Object widget text color:#fff in every aspect."
        },
        "asset_path": { "type": "string", "minLength": 1 },
        "designer_brief": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["asset_path"] },
        { "required": ["designer_brief"] }
      ]
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "kind",
        "natural_only",
        "never_on_youtube_title_or_script"
      ],
      "properties": {
        "url": { "const": "https://owera.com" },
        "kind": { "const": "waitlist" },
        "natural_only": {
          "const": true,
          "description": "Waitlist only if the sentence exists without the link."
        },
        "never_on_youtube_title_or_script": { "const": true }
      }
    },
    "publication": {
      "type": "object",
      "required": ["network", "skip_gate", "format"],
      "properties": {
        "network": { "$ref": "#/definitions/network" },
        "skip_gate": {
          "type": "boolean",
          "const": false,
          "description": "Per Publication. Default false. Do not inherit Channel.default_skip_gate."
        },
        "daily_budget": {
          "type": "integer",
          "const": 0,
          "description": "Default 0 for newly materialized networks. Do not raise live YT budgets here."
        },
        "format": { "$ref": "#/definitions/nativeFormat" },
        "review_still": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Designer review placeholder frame. NOT the publication kind. linkedin/x format.kind stays video; never image or still."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "network": { "const": "youtube_os" } },
            "required": ["network"]
          },
          "then": {
            "allOf": [
              { "$ref": "#/definitions/youtubeOsAdapter" },
              { "$ref": "#/definitions/youtubeOsFormat" }
            ]
          }
        },
        {
          "if": {
            "properties": { "network": { "const": "instagram" } },
            "required": ["network"]
          },
          "then": {
            "allOf": [
              { "$ref": "#/definitions/socialAdapter" },
              { "$ref": "#/definitions/instagramFormat" }
            ]
          }
        },
        {
          "if": {
            "properties": { "network": { "const": "linkedin" } },
            "required": ["network"]
          },
          "then": {
            "allOf": [
              { "$ref": "#/definitions/socialAdapter" },
              { "$ref": "#/definitions/linkedinFormat" }
            ]
          }
        },
        {
          "if": {
            "properties": { "network": { "const": "x" } },
            "required": ["network"]
          },
          "then": {
            "allOf": [
              { "$ref": "#/definitions/socialAdapter" },
              { "$ref": "#/definitions/xFormat" }
            ]
          }
        }
      ]
    },
    "nativeFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ratio", "size", "teaser_duration", "reuse_generic_cut"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["short", "reel", "video"],
          "description": "youtube_os=short, instagram=reel, linkedin/x=video. NEVER image or still. Stills are review placeholders only, not the publication kind."
        },
        "ratio": {
          "type": "string",
          "enum": ["9:16", "1:1", "4:5", "16:9"],
          "description": "Native aspect. Do not reuse one generic cut."
        },
        "size": {
          "type": "string",
          "enum": ["1080×1920", "1080×1080", "1080×1350", "1920×1080"],
          "description": "Native pixel size. Multiplication sign ×, not x."
        },
        "teaser_duration": {
          "type": "string",
          "enum": ["~30–45s (≤60s)", "~15–30s", "~30–45s"],
          "description": "Exact teaser-duration strings from the locked table."
        },
        "reuse_generic_cut": {
          "const": false,
          "description": "Each network gets its own native cut."
        },
        "cut": {
          "type": "string",
          "description": "Instagram only: object_beat_0_3s."
        }
      }
    },
    "youtubeOsFormat": {
      "type": "object",
      "properties": {
        "format": {
          "type": "object",
          "required": ["kind", "ratio", "size", "teaser_duration", "reuse_generic_cut"],
          "properties": {
            "kind": { "const": "short" },
            "ratio": { "const": "9:16" },
            "size": { "const": "1080×1920" },
            "teaser_duration": { "const": "~30–45s (≤60s)" },
            "reuse_generic_cut": { "const": false }
          },
          "not": { "required": ["cut"] }
        }
      }
    },
    "instagramFormat": {
      "type": "object",
      "properties": {
        "format": {
          "type": "object",
          "required": ["kind", "ratio", "size", "teaser_duration", "reuse_generic_cut", "cut"],
          "properties": {
            "kind": { "const": "reel" },
            "ratio": { "const": "9:16" },
            "size": { "const": "1080×1920" },
            "teaser_duration": { "const": "~15–30s" },
            "reuse_generic_cut": { "const": false },
            "cut": {
              "const": "object_beat_0_3s",
              "description": "IG Reel is the object beat 0–3s, not a random crop of the YT short."
            }
          }
        }
      }
    },
    "linkedinFormat": {
      "type": "object",
      "description": "kind=video. NEVER image or still. Not still 1.91:1. Primary 1:1 / 1080×1080; alt 4:5 / 1080×1350. Stills are review placeholders only.",
      "properties": {
        "format": {
          "type": "object",
          "required": ["kind", "ratio", "size", "teaser_duration", "reuse_generic_cut"],
          "properties": {
            "kind": { "const": "video" },
            "ratio": { "enum": ["1:1", "4:5"] },
            "teaser_duration": { "const": "~30–45s" },
            "reuse_generic_cut": { "const": false }
          },
          "not": { "required": ["cut"] },
          "allOf": [
            {
              "if": {
                "properties": { "ratio": { "const": "1:1" } },
                "required": ["ratio"]
              },
              "then": {
                "properties": { "size": { "const": "1080×1080" } }
              }
            },
            {
              "if": {
                "properties": { "ratio": { "const": "4:5" } },
                "required": ["ratio"]
              },
              "then": {
                "properties": { "size": { "const": "1080×1350" } }
              }
            }
          ]
        }
      }
    },
    "xFormat": {
      "type": "object",
      "description": "kind=video 16:9. NEVER image or still. Not still 1:1. Stills are review placeholders only.",
      "properties": {
        "format": {
          "type": "object",
          "required": ["kind", "ratio", "size", "teaser_duration", "reuse_generic_cut"],
          "properties": {
            "kind": { "const": "video" },
            "ratio": { "const": "16:9" },
            "size": { "const": "1920×1080" },
            "teaser_duration": { "const": "~15–30s" },
            "reuse_generic_cut": { "const": false }
          },
          "not": { "required": ["cut"] }
        }
      }
    },
    "youtubeOsAdapter": {
      "type": "object",
      "description": "Handoff to the existing Video (youtube short) pipeline. Do not re-spec generate/render/publish.",
      "required": ["handoff", "channel_scope", "subscribe_endcard"],
      "properties": {
        "handoff": { "const": "video_short" },
        "channel_scope": {
          "const": "os_only",
          "description": "Owera Software / ch1. YouTube RR / ch2 brand=rr is out."
        },
        "video_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional later FK to Video.id. Not allocated by this spec."
        },
        "subscribe_endcard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_subscribe", "series"],
          "properties": {
            "allow_subscribe": {
              "type": "boolean",
              "description": "True only for YPP#5 series endcard. Live sanitize stays on title/script/mid-video/generic description. Do not invert live code."
            },
            "series": {
              "type": ["string", "null"],
              "description": "Set to ypp5 when this publication is that series endcard; otherwise null and allow_subscribe must be false."
            }
          },
          "if": {
            "properties": { "series": { "const": "ypp5" } },
            "required": ["series"]
          },
          "then": {
            "properties": { "allow_subscribe": { "const": true } }
          },
          "else": {
            "properties": { "allow_subscribe": { "const": false } }
          }
        }
      }
    },
    "socialAdapter": {
      "type": "object",
      "description": "Company social. Social Ops after rodrigo_yes. Copy + Designer + Research.",
      "required": ["handle"],
      "properties": {
        "handle": {
          "type": "string",
          "enum": ["@owerasoftware", "linkedin:company"]
        },
        "caption_first_line_is_spoken": { "const": true },
        "daily_budget": { "const": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "network": { "const": "instagram" } },
            "required": ["network"]
          },
          "then": {
            "properties": { "handle": { "const": "@owerasoftware" } }
          }
        },
        {
          "if": {
            "properties": { "network": { "const": "x" } },
            "required": ["network"]
          },
          "then": {
            "properties": { "handle": { "const": "@owerasoftware" } }
          }
        },
        {
          "if": {
            "properties": { "network": { "const": "linkedin" } },
            "required": ["network"]
          },
          "then": {
            "properties": { "handle": { "const": "linkedin:company" } }
          }
        }
      ]
    }
  }
}
