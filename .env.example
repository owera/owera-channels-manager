# Owera Channels Manager — copy to .env (never commit real secrets)

# HTTP Basic Auth for the portal (empty = local-only, no auth).
# When MANAGER_MULTI_WORKSPACE=1, the Basic Auth *username* must be the workspace slug
# (e.g. owera), not empty — use curl -u "owera:$MANAGER_APP_PASSWORD".
MANAGER_APP_PASSWORD=

# Public URL base for legacy per-channel OAuth redirects (optional)
MANAGER_PUBLIC_BASE_URL=

# Platform Google Web OAuth — keep 0 until operator enables on claw0
MANAGER_GOOGLE_WEB_OAUTH=0
MANAGER_GOOGLE_CLIENT_ID=
MANAGER_GOOGLE_CLIENT_SECRET=
MANAGER_OAUTH_REDIRECT_URI=https://channels.owera.com/api/oauth/google/callback
# Platform OAuth token encryption (env key is MANAGER_TOKEN_ENC_KEY, not TOKEN_ENC_KEY)
MANAGER_TOKEN_ENC_KEY=

# SPA human login (Google Sign-In → session cookie). Separate GCP Web OAuth client
# from YouTube Connect (MANAGER_GOOGLE_*). Project 618513602444.
# Allowlist (v1): rodrigo@owera.com → workspace owera (code-locked in app).
MANAGER_SPA_GOOGLE_LOGIN=0
MANAGER_SPA_GOOGLE_CLIENT_ID=
MANAGER_SPA_GOOGLE_CLIENT_SECRET=
MANAGER_SPA_GOOGLE_REDIRECT_URI=https://channels.owera.com/api/auth/google/callback
# Local dev redirect: http://127.0.0.1:7070/api/auth/google/callback
# Authorized JS origins (GCP console): https://channels.owera.com , http://127.0.0.1:7070
MANAGER_SESSION_SECRET=
# Set 1 behind HTTPS so the session cookie and logout deletion both use Secure.
MANAGER_SESSION_COOKIE_SECURE=0

# Multi-tenant workspace isolation — keep 0 for EA until CF Access + slug binding
MANAGER_MULTI_WORKSPACE=0
MANAGER_ALLOW_WORKSPACE_HEADER=0

# Safety ceiling (units/day); workspace row may set a lower cap
MANAGER_YOUTUBE_DAILY_QUOTA_CAP=9000

# Light LLM completions (ideas / autofill / trends / metadata).
# Default low; empty = CLI default (currently high). Compose stays on MANAGER_GROK_COMPOSE_REASONING_EFFORT.
# MANAGER_GROK_EFFORT_IDEAS=low
